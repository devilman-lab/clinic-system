# PostgreSQL の接続文字列（Neon / Vercel Postgres / Supabase など）。
# Vercel の Neon 連携を使う場合は Vercel 側で自動設定されるので、ローカル用に同じ値を貼り付けてください。
# スキーマ反映・デモデータ投入（db:push / db:seed）には、あれば非プール（unpooled / direct）の URL を使うと確実です。
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# セッション Cookie の署名鍵。本番では必ず十分な長さのランダム値に変更してください。
#   openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-value"

# 任意。クリニックの時刻帯。起動時にサーバーの時刻帯をこの値に固定します（既定 Asia/Tokyo）。
# Vercel などは UTC で動くため、この固定がないと朝9時まで前日の予定が表示されます。
# CLINIC_TIMEZONE="Asia/Tokyo"
